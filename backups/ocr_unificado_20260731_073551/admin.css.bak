.login-card{max-width:520px;margin-left:auto;margin-right:auto}
.compact-card{padding-top:22px;padding-bottom:22px}
.dashboard-grid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:16px;margin-top:24px}
.metric-card{background:#fff;border:1px solid var(--border);border-radius:18px;padding:20px;box-shadow:var(--shadow)}
.metric-card span{display:block;color:var(--muted);font-weight:700;font-size:.86rem}
.metric-card strong{display:block;margin-top:7px;color:var(--navy);font-size:2rem}
.metric-card.warning{border-color:#e4c66d;background:#fffaf0}
.metric-card.danger{border-color:#efb6bf;background:#fff4f5}
.status-summary{display:flex;flex-wrap:wrap;gap:10px;margin-top:16px}
.status-pill{display:inline-flex;gap:8px;align-items:center;text-decoration:none;background:var(--blue-soft);color:var(--blue);border:1px solid #cddcf0;border-radius:999px;padding:9px 13px;font-weight:800}
.status-pill:hover{background:#dce9f9}
.expiration{display:inline-block;margin-top:5px;font-weight:800}
.expiration.success{color:var(--green)}
.expiration.warning{color:#9a6a00}
.expiration.danger{color:var(--red)}
.expiration.neutral{color:var(--muted)}
.expediente-card{overflow:hidden}
.expediente-header{display:flex;justify-content:space-between;gap:24px;align-items:flex-start;padding-bottom:24px;border-bottom:1px solid var(--border)}
.expediente-header h2{margin:6px 0;color:var(--navy);font-size:2rem}
.expediente-header p{margin:0;color:var(--muted)}
.expediente-actions{display:flex;align-items:center;gap:12px;flex-wrap:wrap;justify-content:flex-end}
.large-status{background:var(--blue-soft);color:var(--blue);padding:11px 15px;border-radius:999px;font-weight:900}
.tabs{display:flex;gap:8px;border-bottom:1px solid var(--border);margin:24px 0;overflow-x:auto}
.tab-button{appearance:none;border:0;background:transparent;padding:13px 17px;font:inherit;font-weight:900;color:var(--muted);cursor:pointer;border-bottom:3px solid transparent;white-space:nowrap}
.tab-button:hover{color:var(--navy);background:#f6f8fb}
.tab-button.active{color:var(--navy);border-bottom-color:var(--gold)}
.tab-panel{display:none}
.tab-panel.active{display:block}
.detail-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}
.detail-grid>div{background:#f8fafc;border:1px solid var(--border);border-radius:14px;padding:16px;min-height:95px}
.detail-grid span{display:block;color:var(--muted);font-size:.83rem;font-weight:800;margin-bottom:7px}
.detail-grid strong{display:block;color:var(--text);line-height:1.45;overflow-wrap:anywhere}
.detail-grid small{display:block;margin-top:5px;color:var(--muted)}
.barcode-card{max-width:500px;text-align:center;margin-top:22px;border:1px solid var(--border);border-radius:15px;padding:16px;background:#fff}
.barcode-lines{height:70px;margin-bottom:8px;background:repeating-linear-gradient(90deg,#101010 0 2px,transparent 2px 4px,#101010 4px 5px,transparent 5px 9px,#101010 9px 12px,transparent 12px 14px)}
.copy-button{margin-top:8px;border:1px solid var(--border);background:#fff;color:var(--blue);border-radius:8px;padding:6px 9px;cursor:pointer;font-weight:800}
.evidence-status{padding:13px 15px;border-radius:12px;margin-bottom:18px;font-weight:800}
.evidence-status.success{background:#e7f6ee;color:#17663e}
.evidence-status.danger{background:#fdecef;color:#96212c}
.evidence-card{border:1px solid var(--border);border-radius:16px;padding:14px;background:#f9fbfe}
.image-open{display:block;width:100%;padding:0;margin:10px 0;border:0;background:none;cursor:zoom-in}
.download-link{display:inline-block;text-decoration:none;font-weight:800}
.image-modal{display:none;position:fixed;inset:0;z-index:9999;background:rgba(3,12,28,.91);padding:30px}
.image-modal.open{display:grid;place-items:center}
.modal-content{max-width:1100px;width:100%;color:#fff;text-align:center}
.modal-content img{max-width:100%;max-height:82vh;object-fit:contain;border-radius:12px}
.modal-close{position:absolute;top:16px;right:20px;border:0;background:#fff;color:#111;width:46px;height:46px;border-radius:50%;font-size:2rem;cursor:pointer}
.validation-layout{display:grid;grid-template-columns:minmax(220px,.7fr) minmax(0,1.3fr);gap:28px;align-items:start}
.score-ring{--score:0;width:170px;aspect-ratio:1;border-radius:50%;display:grid;place-items:center;align-content:center;background:conic-gradient(var(--green) calc(var(--score)*1%),#e8edf4 0);position:relative;margin:20px 0}
.score-ring::before{content:"";position:absolute;inset:14px;background:#fff;border-radius:50%}
.score-ring strong,.score-ring span{position:relative;z-index:1}
.score-ring strong{font-size:2rem;color:var(--navy)}
.score-ring span{color:var(--muted);font-size:.82rem}
.validation-form{border:1px solid var(--border);border-radius:16px;padding:20px;background:#f9fbfe}
.check-row{display:flex;gap:12px;align-items:flex-start;background:#fff;border:1px solid var(--border);border-radius:12px;padding:14px;margin-bottom:10px;cursor:pointer}
.check-row input{width:auto;margin-top:3px;transform:scale(1.2)}
.barcode-validation-box{border-left:5px solid var(--gold);background:#fff;border-radius:12px;padding:16px;margin:18px 0}
.detection.success{color:var(--green);font-weight:800}
.detection.warning{color:#8a6200;font-weight:800}
.detection.danger{color:var(--red);font-weight:800}
.section-divider{border:0;border-top:1px solid var(--border);margin:30px 0}
.quick-actions textarea{width:100%}
.message-templates{margin-top:28px}
.timeline{position:relative;padding-left:25px}
.timeline::before{content:"";position:absolute;left:7px;top:0;bottom:0;width:2px;background:var(--border)}
.timeline-item{position:relative;border:1px solid var(--border);border-radius:14px;padding:16px;margin-bottom:15px;background:#fff}
.timeline-item::before{content:"";position:absolute;left:-24px;top:20px;width:12px;height:12px;border-radius:50%;background:var(--gold);border:3px solid #fff;box-shadow:0 0 0 1px var(--border)}
.timeline-item time{color:var(--muted);font-size:.82rem;display:block;margin-bottom:6px}
.timeline-item p{margin:8px 0}
.muted{color:var(--muted)}
.section-heading{display:flex;justify-content:space-between;gap:18px;align-items:flex-start}
.filters-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;margin-bottom:24px}
.filter-actions{display:flex;gap:10px;align-items:end}
.mini-score{height:8px;background:#e8edf4;border-radius:999px;overflow:hidden;min-width:90px}
.mini-score span{display:block;height:100%;background:var(--green);border-radius:999px}
.admin-evidence-grid img{aspect-ratio:4/3}
@media(max-width:1100px){.dashboard-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.filters-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:760px){.dashboard-grid,.detail-grid,.validation-layout,.filters-grid{grid-template-columns:1fr}.expediente-header,.section-heading{flex-direction:column}.expediente-actions{justify-content:flex-start}}
@media print{.site-header,.site-footer,.dashboard-grid,.compact-card,.tabs,.filters-grid,.top-nav,.expediente-actions,.actions,.message-templates,.quick-actions,.validation-form button{display:none!important}body{background:#fff}.card{box-shadow:none;border:0}.tab-panel{display:block!important;page-break-inside:avoid}}

/* ===== ESTADOS PROFESIONALES TIPO DASHBOARD ===== */
.status-panel{
  padding-top:26px;
  padding-bottom:28px
}
.status-panel-heading{
  display:flex;
  align-items:flex-start;
  justify-content:space-between;
  gap:20px;
  margin-bottom:24px
}
.status-panel-heading .card-subtitle{
  margin:6px 0 0
}
.btn-small{
  padding:10px 15px;
  font-size:.88rem;
  border-radius:10px
}
.status-bars{
  display:grid;
  gap:15px
}
.status-bar-row{
  display:block;
  color:inherit;
  text-decoration:none;
  padding:4px 0
}
.status-bar-row:hover .status-track span{
  filter:brightness(.92)
}
.status-bar-meta{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:20px;
  margin-bottom:8px
}
.status-bar-meta span{
  color:var(--text);
  font-weight:800;
  font-size:.94rem
}
.status-bar-meta strong{
  min-width:56px;
  text-align:right;
  color:#42506a;
  font-size:.88rem;
  font-variant-numeric:tabular-nums
}
.status-track{
  height:8px;
  overflow:hidden;
  border-radius:999px;
  background:#e7ecf3
}
.status-track span{
  display:block;
  height:100%;
  min-width:5px;
  border-radius:999px;
  background:linear-gradient(90deg,#1f5b9f,#79aee1);
  transition:width .25s ease,filter .2s ease
}
.status-bar-row:first-child .status-track span{
  background:linear-gradient(90deg,#173f7a,#4c8ed1)
}
.status-bar-row:nth-child(2) .status-track span{
  background:linear-gradient(90deg,#2f6fb4,#77abe0)
}
.status-bar-row:nth-child(3) .status-track span{
  background:linear-gradient(90deg,#3f7cba,#91b9df)
}
.status-bar-row:nth-child(n+7) .status-track span{
  background:linear-gradient(90deg,#6d8eaf,#a9bfd4)
}
@media(max-width:760px){
  .status-panel-heading{
    flex-direction:column
  }
  .status-panel-heading .btn{
    width:100%
  }
}

/* ===== DASHBOARD COMPACTO EN DOS COLUMNAS ===== */
body .container{
  width:min(1380px,calc(100% - 40px))
}

.status-panel{
  padding:26px 28px
}

.status-bars{
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  column-gap:34px;
  row-gap:14px
}

.status-bar-row{
  padding:2px 0
}

.status-bar-meta{
  margin-bottom:6px
}

.status-track{
  height:7px
}

.dashboard-grid{
  grid-template-columns:repeat(6,minmax(140px,1fr))
}

@media(max-width:1050px){
  .status-bars{
    grid-template-columns:1fr
  }
}

@media(max-width:760px){
  body .container{
    width:min(100% - 18px,1380px)
  }

  .status-panel{
    padding:20px 16px
  }
}
.risk-summary{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;padding:16px;border-radius:16px;margin-bottom:22px;border:1px solid var(--border)}
.risk-summary>div{background:rgba(255,255,255,.78);border-radius:12px;padding:14px}
.risk-summary span{display:block;color:var(--muted);font-size:.82rem;font-weight:800;margin-bottom:6px}
.risk-summary strong{font-size:1.18rem;color:var(--navy)}
.risk-bajo{background:#eaf8f0;border-color:#add9bf}
.risk-medio{background:#fff8e8;border-color:#e6ca83}
.risk-alto{background:#fff0f2;border-color:#efb3bc}
.duplicate-alert{background:#fff2f3;border:1px solid #efb3bc;border-left:5px solid var(--red);border-radius:14px;padding:16px;margin-bottom:22px}
.duplicate-alert h3{margin-top:0;color:var(--red)}
.duplicate-alert a{display:block;padding:9px 0;font-weight:800;text-decoration:none}
.preset-fieldset{border:1px solid var(--border);border-radius:14px;padding:16px;margin:18px 0;background:#fff}
.preset-fieldset legend{padding:0 8px;font-weight:900;color:var(--navy)}
.preset-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
.preset-option{display:flex;align-items:flex-start;gap:10px;border:1px solid var(--border);border-radius:11px;padding:12px;margin:0;cursor:pointer;background:#f9fbfe}
.preset-option input{width:auto;margin-top:3px}
@media(max-width:760px){.risk-summary,.preset-grid{grid-template-columns:1fr}}

/* ===== OCR ASISTIDO FASE 2 ===== */
.ocr-panel{border:1px solid var(--border);border-radius:18px;padding:22px;margin-bottom:26px;background:linear-gradient(145deg,#f8fbff,#fff)}
.ocr-panel-heading{display:flex;justify-content:space-between;gap:22px;align-items:flex-start;margin-bottom:18px}
.ocr-panel-heading h3{margin:6px 0;color:var(--navy)}
.ocr-panel-heading p{margin:0;max-width:720px;color:var(--muted);line-height:1.55}
.ocr-score-box{min-width:145px;text-align:center;border:1px solid var(--border);border-radius:14px;background:#fff;padding:14px}
.ocr-score-box span{display:block;color:var(--muted);font-size:.8rem;font-weight:800}
.ocr-score-box strong{display:block;color:var(--navy);font-size:1.8rem;margin-top:5px}
.ocr-progress{height:9px;border-radius:999px;overflow:hidden;background:#e7ecf3;margin:18px 0 10px}
.ocr-progress span{display:block;height:100%;width:0;border-radius:999px;background:linear-gradient(90deg,#1f5b9f,#75abe0);transition:width .2s ease}
.ocr-status{color:var(--muted);font-weight:700}
.ocr-status.success{color:var(--green)}
.ocr-status.warning{color:#906400}
.ocr-status.danger{color:var(--red)}
.ocr-comparison{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin-top:18px}
.ocr-check{display:flex;gap:12px;align-items:flex-start;border:1px solid var(--border);border-radius:12px;padding:13px;background:#fff}
.ocr-check>span{display:grid;place-items:center;width:28px;height:28px;border-radius:50%;font-weight:900}
.ocr-check strong,.ocr-check small{display:block}
.ocr-check small{margin-top:4px;color:var(--muted)}
.ocr-check.matched>span{background:#e5f6ec;color:var(--green)}
.ocr-check.not-matched>span{background:#fff1f2;color:var(--red)}
.ocr-text-details{margin-top:20px;border-top:1px solid var(--border);padding-top:16px}
.ocr-text-details summary{cursor:pointer;font-weight:900;color:var(--navy)}
.ocr-text-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;margin-top:15px}
.ocr-text-grid textarea{min-height:220px;font-family:ui-monospace,SFMono-Regular,Consolas,monospace;font-size:.82rem}
@media(max-width:760px){.ocr-panel-heading{flex-direction:column}.ocr-score-box{width:100%}.ocr-comparison,.ocr-text-grid{grid-template-columns:1fr}}

/* ===== VISIÓN ARTIFICIAL FASE 3 ===== */
.vision-tools{
  margin:18px 0;
  padding:18px;
  border:1px solid var(--border);
  border-radius:15px;
  background:#fff
}
.vision-preview-grid,
.vision-quality-grid{
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:14px;
  margin-top:16px
}
.vision-preview-grid>div{
  border:1px solid var(--border);
  border-radius:12px;
  padding:12px;
  background:#f8fafc
}
.vision-preview-grid img{
  display:block;
  width:100%;
  max-height:280px;
  object-fit:contain;
  margin-top:10px;
  border-radius:10px;
  background:#e9edf3
}
.vision-quality-card{
  border:1px solid var(--border);
  border-radius:12px;
  padding:14px;
  background:#f9fbfe
}
.vision-quality-card h4{
  margin:0 0 10px;
  color:var(--navy)
}
.vision-quality-card div{
  padding:7px 9px;
  border-radius:8px;
  margin-top:7px;
  font-weight:800
}
.quality-ok{
  background:#e7f6ee;
  color:#17663e
}
.quality-bad{
  background:#fdecef;
  color:#96212c
}
@media(max-width:760px){
  .vision-preview-grid,.vision-quality-grid{grid-template-columns:1fr}
}

/* ===== OCR ESPECIALIZADO POR ZONAS ===== */
.zone-ocr-panel{
  border:1px solid var(--border);
  border-radius:18px;
  padding:22px;
  margin:0 0 26px;
  background:linear-gradient(145deg,#fffdf8,#fff)
}
.zone-ocr-heading{
  display:flex;
  justify-content:space-between;
  gap:22px;
  align-items:flex-start;
  margin-bottom:18px
}
.zone-ocr-heading h3{
  margin:6px 0;
  color:var(--navy)
}
.zone-ocr-heading p{
  margin:0;
  color:var(--muted);
  max-width:700px;
  line-height:1.55
}
.zone-preview-grid{
  display:grid;
  grid-template-columns:repeat(3,minmax(0,1fr));
  gap:12px;
  margin-top:18px
}
.zone-preview-grid article{
  border:1px solid var(--border);
  border-radius:12px;
  background:#f8fafc;
  padding:12px
}
.zone-preview-grid img{
  display:block;
  width:100%;
  max-height:230px;
  object-fit:contain;
  margin-top:9px;
  border-radius:8px;
  background:#e9edf3
}
@media(max-width:850px){
  .zone-preview-grid{grid-template-columns:1fr}
  .zone-ocr-heading{flex-direction:column}
}
