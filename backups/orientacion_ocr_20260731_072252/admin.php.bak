<?php

declare(strict_types=1);

session_start();
require __DIR__ . '/db.php';
require __DIR__ . '/validation_engine.php';

if (isset($_GET['logout'])) {
    session_destroy();
    header('Location: admin.php');
    exit;
}

$loginError = '';

if ($_SERVER['REQUEST_METHOD'] === 'POST' && isset($_POST['login'])) {
    $user = trim((string) ($_POST['username'] ?? ''));
    $password = (string) ($_POST['password'] ?? '');

    if (
        hash_equals((string) $config['admin_user'], $user)
        && hash_equals((string) $config['admin_password'], $password)
    ) {
        session_regenerate_id(true);
        $_SESSION['admin_authenticated'] = true;
        $_SESSION['admin_user'] = $user;
        header('Location: admin.php');
        exit;
    }

    $loginError = 'Usuario o contraseña incorrectos.';
}

$authenticated = !empty($_SESSION['admin_authenticated']);
$selected = null;
$requests = [];
$summary = [];
$history = [];
$units = [];

function formatDateEs(?string $date, bool $withTime = false): string
{
    if (!$date) {
        return 'No indicada';
    }

    try {
        $value = new DateTimeImmutable($date);
        return $value->format($withTime ? 'd/m/Y h:i A' : 'd/m/Y');
    } catch (Throwable) {
        return $date;
    }
}

function expirationInfo(?string $date): array
{
    if (!$date) {
        return ['class' => 'neutral', 'label' => 'Sin fecha', 'days' => null];
    }

    $today = new DateTimeImmutable('today');
    $expiration = new DateTimeImmutable($date);
    $days = (int) $today->diff($expiration)->format('%r%a');

    if ($days < 0) {
        return ['class' => 'danger', 'label' => 'Vencido hace ' . abs($days) . ' días', 'days' => $days];
    }
    if ($days <= 15) {
        return ['class' => 'danger', 'label' => 'Vence en ' . $days . ' días', 'days' => $days];
    }
    if ($days <= 30) {
        return ['class' => 'warning', 'label' => 'Vence en ' . $days . ' días', 'days' => $days];
    }

    return ['class' => 'success', 'label' => 'Vigente', 'days' => $days];
}

function categoryLabel(?string $category): string
{
    return match ($category) {
        'DIRECCION' => 'Dirección',
        'ZONA' => 'Zona Policial',
        'SERVICIO' => 'Servicio Policial',
        default => 'Unidad institucional',
    };
}

function evidenceComplete(array $row): bool
{
    return !empty($row['card_front_path'])
        && !empty($row['card_back_path'])
        && !empty($row['person_with_card_path']);
}

function validationScore(array $row): int
{
    $checks = [
        !empty($row['barcode_verified']),
        !empty($row['identity_verified']),
        !empty($row['photos_verified']),
        !empty($row['expiration_verified']),
    ];

    return (int) round((count(array_filter($checks)) / count($checks)) * 100);
}

if ($authenticated) {
    $units = $pdo->query(
        'SELECT id, code, name, category
         FROM institutional_units
         WHERE active = 1
         ORDER BY category, name'
    )->fetchAll();

    $locationSelect = <<<SQL
SELECT
    r.*,
    iu.code AS institutional_unit_code,
    iu.name AS institutional_unit_name,
    iu.category AS institutional_unit_category
FROM requests r
LEFT JOIN institutional_units iu ON iu.id = r.institutional_unit_id
SQL;

    $statusFilter = trim((string) ($_GET['status'] ?? ''));
    $search = trim((string) ($_GET['q'] ?? ''));
    $unitFilter = (int) ($_GET['unit'] ?? 0);
    $categoryFilter = trim((string) ($_GET['category'] ?? ''));
    $expirationFilter = trim((string) ($_GET['expiration'] ?? ''));
    $evidenceFilter = trim((string) ($_GET['evidence'] ?? ''));
    $dateFrom = trim((string) ($_GET['date_from'] ?? ''));
    $dateTo = trim((string) ($_GET['date_to'] ?? ''));

    $where = [];
    $params = [];

    if ($statusFilter !== '') {
        $where[] = 'r.status = :status';
        $params['status'] = $statusFilter;
    }

    if ($search !== '') {
        $where[] = '(
            r.request_number LIKE :q OR r.position_number LIKE :q
            OR r.national_id LIKE :q OR r.first_name LIKE :q
            OR r.middle_name LIKE :q OR r.last_name LIKE :q
            OR r.second_last_name LIKE :q OR r.barcode_value LIKE :q
            OR r.exact_work_location LIKE :q OR r.phone LIKE :q
            OR r.email LIKE :q OR iu.name LIKE :q OR iu.code LIKE :q
        )';
        $params['q'] = '%' . $search . '%';
    }

    if ($unitFilter > 0) {
        $where[] = 'r.institutional_unit_id = :unit';
        $params['unit'] = $unitFilter;
    }

    if (in_array($categoryFilter, ['DIRECCION', 'ZONA', 'SERVICIO'], true)) {
        $where[] = 'iu.category = :category';
        $params['category'] = $categoryFilter;
    }

    if ($expirationFilter === 'expired') {
        $where[] = 'r.card_expiration_date < CURDATE()';
    } elseif ($expirationFilter === '15') {
        $where[] = 'r.card_expiration_date BETWEEN CURDATE() AND DATE_ADD(CURDATE(), INTERVAL 15 DAY)';
    } elseif ($expirationFilter === '30') {
        $where[] = 'r.card_expiration_date BETWEEN CURDATE() AND DATE_ADD(CURDATE(), INTERVAL 30 DAY)';
    } elseif ($expirationFilter === 'valid') {
        $where[] = 'r.card_expiration_date > DATE_ADD(CURDATE(), INTERVAL 30 DAY)';
    }

    if ($evidenceFilter === 'complete') {
        $where[] = "r.card_front_path IS NOT NULL AND r.card_front_path <> ''
                    AND r.card_back_path IS NOT NULL AND r.card_back_path <> ''
                    AND r.person_with_card_path IS NOT NULL AND r.person_with_card_path <> ''";
    } elseif ($evidenceFilter === 'missing') {
        $where[] = "(r.card_front_path IS NULL OR r.card_front_path = ''
                     OR r.card_back_path IS NULL OR r.card_back_path = ''
                     OR r.person_with_card_path IS NULL OR r.person_with_card_path = '')";
    }

    if ($dateFrom !== '') {
        $where[] = 'DATE(r.submitted_at) >= :date_from';
        $params['date_from'] = $dateFrom;
    }

    if ($dateTo !== '') {
        $where[] = 'DATE(r.submitted_at) <= :date_to';
        $params['date_to'] = $dateTo;
    }

    $sql = $locationSelect
        . ($where ? ' WHERE ' . implode(' AND ', $where) : '')
        . ' ORDER BY r.submitted_at DESC LIMIT 500';

    $stmt = $pdo->prepare($sql);
    $stmt->execute($params);
    $requests = $stmt->fetchAll();

    $summaryRow = $pdo->query(
        "SELECT
            COUNT(*) AS total,
            SUM(DATE(submitted_at) = CURDATE()) AS today_total,
            SUM(YEARWEEK(submitted_at, 1) = YEARWEEK(CURDATE(), 1)) AS week_total,
            SUM(YEAR(submitted_at) = YEAR(CURDATE()) AND MONTH(submitted_at) = MONTH(CURDATE())) AS month_total,
            SUM(card_expiration_date < CURDATE()) AS expired_total,
            SUM(card_expiration_date BETWEEN CURDATE() AND DATE_ADD(CURDATE(), INTERVAL 30 DAY)) AS expiring_total
         FROM requests"
    )->fetch();

    $summary = $summaryRow ?: [];

    $statusSummary = [];
    foreach ($pdo->query('SELECT status, COUNT(*) AS total FROM requests GROUP BY status') as $row) {
        $statusSummary[$row['status']] = (int) $row['total'];
    }

    if (isset($_GET['view'])) {
        $detail = $pdo->prepare($locationSelect . ' WHERE r.id = ? LIMIT 1');
        $detail->execute([(int) $_GET['view']]);
        $selected = $detail->fetch() ?: null;

        if ($selected) {
            $historyStmt = $pdo->prepare(
                'SELECT previous_status, new_status, observation, changed_by, changed_at
                 FROM status_history
                 WHERE request_id = ?
                 ORDER BY changed_at DESC, id DESC'
            );
            $historyStmt->execute([(int) $selected['id']]);
            $history = $historyStmt->fetchAll();
        }
    }
}
