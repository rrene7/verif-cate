                        <div class="barcode-validation-box">
                            <strong>Validación del código de barras</strong>
                            <p>Registrado: <code><?= e($selected['barcode_value'] ?: 'Sin código') ?></code></p>
                            <p id="barcodeDetectionResult">Presione el botón para intentar leer el reverso.</p>
                            <button type="button" class="btn btn-outline" id="detectBarcode"
                                    data-image="<?= e($selected['card_back_path'] ?? '') ?>"
                                    data-expected="<?= e($selected['barcode_value'] ?? '') ?>">
                                Detectar código en fotografía
                            </button>
                        </div>

                        <fieldset class="preset-fieldset">
    <legend>Hallazgos predeterminados</legend>
    <?php
    $savedPresets = json_decode((string)($selected['validation_notes_json'] ?? '[]'), true);
    if (!is_array($savedPresets)) $savedPresets = [];
    $presetOptions = [
        'FOTO_BORROSA'=>'Foto borrosa',
        'CARNE_VENCIDO'=>'Carné vencido',
        'CODIGO_ILEGIBLE'=>'Código ilegible',
        'DATOS_INCOMPLETOS'=>'Datos incompletos',
        'DOCUMENTO_DETERIORADO'=>'Documento deteriorado',
        'NUEVA_FOTOGRAFIA'=>'Se requiere nueva fotografía',
        'CODIGO_NO_COINCIDE'=>'El código no coincide',
        'POSIBLE_DUPLICADO'=>'Posible duplicado'
    ];
    ?>
    <div class="preset-grid">
        <?php foreach ($presetOptions as $k=>$label): ?>
        <label class="preset-option">
            <input type="checkbox" name="validation_presets[]" value="<?= e($k) ?>"
                <?= in_array($k,$savedPresets,true) ? 'checked' : '' ?>>
            <span><?= e($label) ?></span>
        </label>
        <?php endforeach; ?>
    </div>
</fieldset>

<label for="validation_observation">Observación de validación</label>
                        <textarea id="validation_observation" name="admin_observation"><?= e($selected['admin_observation'] ?? '') ?></textarea>

                        <button class="btn btn-primary" type="submit">Guardar validación</button>
                    </form>
                </div>

                <hr class="section-divider">

                <h3>Acciones rápidas</h3>
                <form method="post" action="admin_update.php" class="quick-actions">
                    <input type="hidden" name="id" value="<?= (int) $selected['id'] ?>">
                    <input type="hidden" name="action_type" value="status">
                    <textarea name="admin_observation" placeholder="Observación para el funcionario o para el historial"></textarea>
                    <div class="actions">
                        <?php foreach ($config['statuses'] as $key => $label): ?>
                            <button class="btn <?= $key === $selected['status'] ? 'btn-outline' : 'btn-primary' ?>"
                                    type="submit" name="status" value="<?= e($key) ?>">
                                <?= e($label) ?>
                            </button>
                        <?php endforeach; ?>
                    </div>
                </form>

                <div class="message-templates">
                    <h3>Plantillas de WhatsApp</h3>
                    <?php
                    $phone = preg_replace('/\D+/', '', (string) $selected['phone']);
                    $templates = [
                        'Solicitud recibida' => "Buen día. Su solicitud {$selected['request_number']} fue recibida correctamente.",
                        'Corrección requerida' => "Buen día. Su solicitud {$selected['request_number']} requiere una corrección. Revise la observación registrada por Recursos Humanos.",
                        'Solicitud aprobada' => "Buen día. Su solicitud {$selected['request_number']} fue aprobada.",
                    ];
                    ?>
                    <div class="actions">
                        <?php foreach ($templates as $label => $message): ?>
                            <a class="btn btn-whatsapp" target="_blank" rel="noopener"
                               href="https://wa.me/507<?= e($phone) ?>?text=<?= rawurlencode($message) ?>">
                                <?= e($label) ?>
                            </a>
                        <?php endforeach; ?>
                    </div>
                </div>
            </div>

            <div class="tab-panel" id="tab-historial">
                <div class="timeline">
                    <?php foreach ($history as $item): ?>
                        <article class="timeline-item">
                            <time><?= e(formatDateEs($item['changed_at'], true)) ?></time>
                            <strong><?= e($config['statuses'][$item['new_status']] ?? $item['new_status']) ?></strong>
                            <p><?= e($item['observation'] ?: 'Sin observación') ?></p>
                            <small>Por: <?= e($item['changed_by']) ?></small>
                        </article>
                    <?php endforeach; ?>

                    <?php if (!$history): ?>
                        <p>No hay movimientos registrados.</p>
                    <?php endif; ?>
                </div>
            </div>
        </section>
    <?php endif; ?>

    <section class="card">
        <div class="section-heading">
            <div>
                <h2 class="card-title">Solicitudes</h2>
                <p class="card-subtitle">Resultados encontrados: <?= count($requests) ?></p>
            </div>
            <a class="btn btn-outline" href="admin_export.php?<?= e(http_build_query($_GET)) ?>">Exportar CSV</a>
        </div>

        <form method="get" class="filters-grid">
            <div><label for="q">Buscar</label><input id="q" name="q" value="<?= e($_GET['q'] ?? '') ?>" placeholder="Solicitud, nombre, cédula, unidad, correo..."></div>
            <div><label for="status_filter">Estado</label><select id="status_filter" name="status"><option value="">Todos</option><?php foreach ($config['statuses'] as $key => $label): ?><option value="<?= e($key) ?>" <?= ($_GET['status'] ?? '') === $key ? 'selected' : '' ?>><?= e($label) ?></option><?php endforeach; ?></select></div>
            <div><label for="category">Categoría</label><select id="category" name="category"><option value="">Todas</option><option value="DIRECCION" <?= ($_GET['category'] ?? '') === 'DIRECCION' ? 'selected' : '' ?>>Direcciones</option><option value="ZONA" <?= ($_GET['category'] ?? '') === 'ZONA' ? 'selected' : '' ?>>Zonas</option><option value="SERVICIO" <?= ($_GET['category'] ?? '') === 'SERVICIO' ? 'selected' : '' ?>>Servicios</option></select></div>
            <div><label for="unit">Unidad</label><select id="unit" name="unit"><option value="">Todas</option><?php foreach ($units as $unit): ?><option value="<?= (int) $unit['id'] ?>" <?= (int) ($_GET['unit'] ?? 0) === (int) $unit['id'] ? 'selected' : '' ?>><?= e($unit['name']) ?></option><?php endforeach; ?></select></div>
            <div><label for="expiration">Expiración</label><select id="expiration" name="expiration"><option value="">Todas</option><option value="expired" <?= ($_GET['expiration'] ?? '') === 'expired' ? 'selected' : '' ?>>Vencidos</option><option value="15" <?= ($_GET['expiration'] ?? '') === '15' ? 'selected' : '' ?>>Vencen en 15 días</option><option value="30" <?= ($_GET['expiration'] ?? '') === '30' ? 'selected' : '' ?>>Vencen en 30 días</option><option value="valid" <?= ($_GET['expiration'] ?? '') === 'valid' ? 'selected' : '' ?>>Vigentes +30 días</option></select></div>
            <div><label for="evidence">Evidencias</label><select id="evidence" name="evidence"><option value="">Todas</option><option value="complete" <?= ($_GET['evidence'] ?? '') === 'complete' ? 'selected' : '' ?>>Completas</option><option value="missing" <?= ($_GET['evidence'] ?? '') === 'missing' ? 'selected' : '' ?>>Incompletas</option></select></div>
            <div><label for="date_from">Desde</label><input type="date" id="date_from" name="date_from" value="<?= e($_GET['date_from'] ?? '') ?>"></div>
            <div><label for="date_to">Hasta</label><input type="date" id="date_to" name="date_to" value="<?= e($_GET['date_to'] ?? '') ?>"></div>
            <div class="filter-actions"><button class="btn btn-primary" type="submit">Filtrar</button><a class="btn btn-outline" href="admin.php">Limpiar</a></div>
        </form>

        <div class="table-wrap">
            <table>
                <thead><tr><th>Solicitud</th><th>Funcionario</th><th>Unidad / ubicación</th><th>Carné</th><th>Validación</th><th>Estado</th><th>Acción</th></tr></thead>
                <tbody>
                <?php foreach ($requests as $row): ?>
                    <?php $rowExpiration = expirationInfo($row['card_expiration_date']); ?>
                    <tr>
                        <td><strong><?= e($row['request_number']) ?></strong><br><small><?= e(formatDateEs($row['submitted_at'], true)) ?></small></td>
                        <td><?= e(trim($row['rank_name'] . ' ' . $row['first_name'] . ' ' . $row['last_name'])) ?><br><small>Pos. <?= e($row['position_number']) ?> · <?= e($row['national_id']) ?></small></td>
                        <td><?= e($row['institutional_unit_name'] ?? 'No indicada') ?><br><small><?= e($row['exact_work_location'] ?: 'Sin ubicación exacta') ?></small></td>
                        <td><?= e(str_replace('_', ' ', $row['card_condition'])) ?><br><small class="expiration <?= e($rowExpiration['class']) ?>"><?= e(formatDateEs($row['card_expiration_date'])) ?> · <?= e($rowExpiration['label']) ?></small></td>
                        <td><div class="mini-score"><span style="width:<?= validationScore($row) ?>%"></span></div><small><?= validationScore($row) ?>%</small></td>
                        <td><span class="status-badge"><?= e($config['statuses'][$row['status']] ?? $row['status']) ?></span></td>
                        <td><a class="btn btn-outline" href="admin.php?view=<?= (int) $row['id'] ?>#expediente">Revisar</a></td>
                    </tr>
                <?php endforeach; ?>
                <?php if (!$requests): ?><tr><td colspan="7">No hay solicitudes que coincidan con los filtros.</td></tr><?php endif; ?>
                </tbody>
            </table>
        </div>
    </section>
<?php endif; ?>
</main>

