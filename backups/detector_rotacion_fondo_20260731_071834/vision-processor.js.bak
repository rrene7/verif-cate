window.VerifCateVision = (() => {
    const CARD_RATIO = 85.60 / 53.98;

    const loadImage = (url) => new Promise((resolve, reject) => {
        const image = new Image();
        image.crossOrigin = 'anonymous';
        image.onload = () => resolve(image);
        image.onerror = () => reject(new Error('No se pudo cargar la imagen.'));
        image.src = url;
    });

    const orderPoints = (points) => {
        const sorted = [...points].sort((a, b) => a.y - b.y);
        const top = sorted.slice(0, 2).sort((a, b) => a.x - b.x);
        const bottom = sorted.slice(2).sort((a, b) => a.x - b.x);

        return [
            top[0],
            top[1],
            bottom[1],
            bottom[0]
        ];
    };

    const distance = (a, b) =>
        Math.sqrt(Math.pow(a.x - b.x, 2) + Math.pow(a.y - b.y, 2));

    const contourToPoints = (approx) => {
        const points = [];
        for (let i = 0; i < 4; i++) {
            points.push({
                x: approx.intPtr(i, 0)[0],
                y: approx.intPtr(i, 0)[1]
            });
        }
        return orderPoints(points);
    };

    const detectBestCardContour = (src) => {
        const gray = new cv.Mat();
        const blurred = new cv.Mat();
        const edges = new cv.Mat();
        const contours = new cv.MatVector();
        const hierarchy = new cv.Mat();

        cv.cvtColor(src, gray, cv.COLOR_RGBA2GRAY);
        cv.GaussianBlur(gray, blurred, new cv.Size(5, 5), 0);
        cv.Canny(blurred, edges, 50, 160);
        cv.morphologyEx(
            edges,
            edges,
            cv.MORPH_CLOSE,
            cv.getStructuringElement(cv.MORPH_RECT, new cv.Size(7, 7))
        );

        cv.findContours(
            edges,
            contours,
            hierarchy,
            cv.RETR_EXTERNAL,
            cv.CHAIN_APPROX_SIMPLE
        );

        let best = null;
        let bestScore = 0;
        const imageArea = src.cols * src.rows;

        for (let i = 0; i < contours.size(); i++) {
            const contour = contours.get(i);
            const area = cv.contourArea(contour);

            if (area < imageArea * 0.02) {
                contour.delete();
                continue;
            }

            const perimeter = cv.arcLength(contour, true);
            const approx = new cv.Mat();
            cv.approxPolyDP(contour, approx, 0.02 * perimeter, true);

            if (approx.rows === 4 && cv.isContourConvex(approx)) {
                const rect = cv.boundingRect(approx);
                const ratio = Math.max(rect.width, rect.height) / Math.min(rect.width, rect.height);
                const ratioScore = Math.max(0, 1 - Math.abs(ratio - CARD_RATIO) / CARD_RATIO);
                const areaScore = area / imageArea;
                const score = areaScore * 0.75 + ratioScore * 0.25;

                if (score > bestScore) {
                    best?.delete();
                    best = approx.clone();
                    bestScore = score;
                }
            }

            approx.delete();
            contour.delete();
        }

        gray.delete();
        blurred.delete();
        edges.delete();
        contours.delete();
        hierarchy.delete();

        return best;
    };

    const warpPerspective = (src, points) => {
        const [tl, tr, br, bl] = points;
        const widthA = distance(br, bl);
        const widthB = distance(tr, tl);
        const heightA = distance(tr, br);
        const heightB = distance(tl, bl);

        let width = Math.round(Math.max(widthA, widthB));
        let height = Math.round(Math.max(heightA, heightB));

        if (height > width) {
            [width, height] = [height, width];
        }

        width = Math.max(width, 1200);
        height = Math.round(width / CARD_RATIO);

        const srcPoints = cv.matFromArray(4, 1, cv.CV_32FC2, [
            tl.x, tl.y,
            tr.x, tr.y,
            br.x, br.y,
            bl.x, bl.y
        ]);

        const dstPoints = cv.matFromArray(4, 1, cv.CV_32FC2, [
            0, 0,
            width - 1, 0,
            width - 1, height - 1,
            0, height - 1
        ]);

        const matrix = cv.getPerspectiveTransform(srcPoints, dstPoints);
        const warped = new cv.Mat();

        cv.warpPerspective(
            src,
            warped,
            matrix,
            new cv.Size(width, height),
            cv.INTER_CUBIC,
            cv.BORDER_REPLICATE,
            new cv.Scalar()
        );

        srcPoints.delete();
        dstPoints.delete();
        matrix.delete();

        return warped;
    };

    const enhanceForOcr = (src) => {
        const gray = new cv.Mat();
        const denoised = new cv.Mat();
        const enhanced = new cv.Mat();

        cv.cvtColor(src, gray, cv.COLOR_RGBA2GRAY);
        /*
         * noise reduction no está disponible en todas las
         * compilaciones de OpenCV.js. GaussianBlur es compatible
         * y reduce el ruido antes del umbral adaptativo.
         */
        cv.GaussianBlur(
            gray,
            denoised,
            new cv.Size(3, 3),
            0,
            0,
            cv.BORDER_DEFAULT
        );
        cv.adaptiveThreshold(
            denoised,
            enhanced,
            255,
            cv.ADAPTIVE_THRESH_GAUSSIAN_C,
            cv.THRESH_BINARY,
            31,
            10
        );

        gray.delete();
        denoised.delete();

        return enhanced;
    };

    const matToDataUrl = (mat) => {
        const canvas = document.createElement('canvas');
        cv.imshow(canvas, mat);
        return canvas.toDataURL('image/png', 1);
    };

    const blurScore = (src) => {
        const gray = new cv.Mat();
        const laplacian = new cv.Mat();
        const mean = new cv.Mat();
        const stddev = new cv.Mat();

        cv.cvtColor(src, gray, cv.COLOR_RGBA2GRAY);
        cv.Laplacian(gray, laplacian, cv.CV_64F);
        cv.meanStdDev(laplacian, mean, stddev);

        const score = Math.pow(stddev.doubleAt(0, 0), 2);

        gray.delete();
        laplacian.delete();
        mean.delete();
        stddev.delete();

        return Math.round(score);
    };

    const glareScore = (src) => {
        const gray = new cv.Mat();
        const mask = new cv.Mat();

        cv.cvtColor(src, gray, cv.COLOR_RGBA2GRAY);
        cv.threshold(gray, mask, 245, 255, cv.THRESH_BINARY);

        const brightPixels = cv.countNonZero(mask);
        const score = Math.round((brightPixels / (src.rows * src.cols)) * 100);

        gray.delete();
        mask.delete();

        return score;
    };

    const process = async (imageUrl) => {
        const image = await loadImage(imageUrl);
        const src = cv.imread(image);
        let contour = null;
        let card = null;
        let enhanced = null;

        try {
            contour = detectBestCardContour(src);

            if (!contour) {
                throw new Error('No se detectó un rectángulo de carné. Tome la foto más cerca y con los cuatro bordes visibles.');
            }

            const points = contourToPoints(contour);
            card = warpPerspective(src, points);
            enhanced = enhanceForOcr(card);

            const sourceArea = src.cols * src.rows;
            const cardArea = cv.contourArea(contour);
            const coverage = Math.round((cardArea / sourceArea) * 100);
            const blur = blurScore(card);
            const glare = glareScore(card);

            return {
                croppedUrl: matToDataUrl(card),
                enhancedUrl: matToDataUrl(enhanced),
                quality: {
                    coverage,
                    blur,
                    glare,
                    coverageOk: coverage >= 20,
                    blurOk: blur >= 80,
                    glareOk: glare <= 8
                }
            };
        } finally {
            src.delete();
            contour?.delete();
            card?.delete();
            enhanced?.delete();
        }
    };

    return { process };
})();
